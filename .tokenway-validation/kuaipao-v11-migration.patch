+func TestKuaipaoModelListManagementRoutesJoinBaseURLAndUseBearerAuth(t *testing.T) {
+	tests := []struct {
+		name         string
+		baseURL      string
+		upstreamPath string
+		wantURL      string
+	}{
+		{
+			name:         "Claude root base",
+			baseURL:      "https://kuaipao.pro",
+			upstreamPath: "/v1/models",
+			wantURL:      "https://kuaipao.pro/v1/models",
+		},
+		{
+			name:         "OpenAI v1 base",
+			baseURL:      "https://kuaipao.pro/v1",
+			upstreamPath: "/models",
+			wantURL:      "https://kuaipao.pro/v1/models",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			info := advancedCustomRelayInfo(&dto.AdvancedCustomConfig{
+				Routes: []dto.AdvancedCustomRoute{{
+					IncomingPath: "/v1/models",
+					UpstreamPath: tt.upstreamPath,
+					Converter:    relayconvert.ConverterNone,
+					Models:       []string{},
+					Auth: &dto.AdvancedCustomRouteAuth{
+						Type:  dto.AdvancedCustomAuthTypeHeader,
+						Name:  "Authorization",
+						Value: "Bearer {api_key}",
+					},
+				}},
+			})
+			info.ChannelBaseUrl = tt.baseURL
+
+			gotURL, headers, err := (&Adaptor{}).BuildModelListRequest(info)
+
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantURL, gotURL)
+			assert.Equal(t, "Bearer sk-test", headers.Get("Authorization"))
+		})
+	}
+}
