+func TestKuaipaoPresetRoutesJoinBaseURLWithoutDuplicateV1(t *testing.T) {
+	tests := []struct {
+		name         string
+		baseURL      string
+		incomingPath string
+		upstreamPath string
+		wantURL      string
+	}{
+		{
+			name:         "Claude Messages",
+			baseURL:      "https://kuaipao.pro",
+			incomingPath: "/v1/messages",
+			upstreamPath: "/v1/messages",
+			wantURL:      "https://kuaipao.pro/v1/messages",
+		},
+		{
+			name:         "OpenAI Chat Completions",
+			baseURL:      "https://kuaipao.pro/v1",
+			incomingPath: "/v1/chat/completions",
+			upstreamPath: "/chat/completions",
+			wantURL:      "https://kuaipao.pro/v1/chat/completions",
+		},
+		{
+			name:         "OpenAI Responses",
+			baseURL:      "https://kuaipao.pro/v1",
+			incomingPath: "/v1/responses",
+			upstreamPath: "/responses",
+			wantURL:      "https://kuaipao.pro/v1/responses",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			info := advancedCustomRelayInfo(&dto.AdvancedCustomConfig{
+				Routes: []dto.AdvancedCustomRoute{{
+					IncomingPath: tt.incomingPath,
+					UpstreamPath: tt.upstreamPath,
+					Converter:    relayconvert.ConverterNone,
+				}},
+			})
+			info.ChannelBaseUrl = tt.baseURL
+			info.RequestURLPath = tt.incomingPath
+
+			got, err := (&Adaptor{}).GetRequestURL(info)
+
+			require.NoError(t, err)
+			assert.Equal(t, tt.wantURL, got)
+		})
+	}
+}
